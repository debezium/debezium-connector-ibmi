/* Version 2.0 (https://www.apache.org/licenses/LICENSE-2.0). */
/* One exact retained D/CT or D/CG; QDBRPLAY names-only is fixed. */
PGM PARM(&J &C &O)
DCL VAR(&J) TYPE(*CHAR) LEN(20)
DCL VAR(&C) TYPE(*CHAR) LEN(32767)
DCL VAR(&O) TYPE(*CHAR) LEN(32767)
DCL VAR(&BP) TYPE(*PTR)
DCL VAR(&EP) TYPE(*PTR)
DCL VAR(&DP) TYPE(*PTR)
DCL VAR(&FP) TYPE(*PTR)
DCL VAR(&PP) TYPE(*PTR)
DCL VAR(&XP) TYPE(*PTR) STG(*BASED) BASPTR(&PP)
DCL VAR(&SRC) TYPE(*PTR)
DCL VAR(&DST) TYPE(*PTR)
DCL VAR(&RETURN) TYPE(*PTR)
DCL VAR(&B) TYPE(*CHAR) LEN(32767) STG(*BASED) BASPTR(&BP)
DCL VAR(&E) TYPE(*CHAR) LEN(32767) STG(*BASED) BASPTR(&EP)
DCL VAR(&D) TYPE(*CHAR) LEN(32767) STG(*BASED) BASPTR(&DP)
DCL VAR(&F) TYPE(*CHAR) LEN(32767) STG(*BASED) BASPTR(&FP)
DCL VAR(&SIZE) TYPE(*INT) LEN(4) VALUE(1048576)
DCL VAR(&AT) TYPE(*INT) LEN(4)
DCL VAR(&BYTES) TYPE(*INT) LEN(4)
DCL VAR(&ESD) TYPE(*INT) LEN(4)
DCL VAR(&DIGITS) TYPE(*CHAR) LEN(5)
DCL VAR(&LEN) TYPE(*INT) LEN(4)
DCL VAR(&EXTRA) TYPE(*INT) LEN(4)
DCL VAR(&FULL) TYPE(*INT) LEN(4)
DCL VAR(&COPY) TYPE(*INT) LEN(4)
DCL VAR(&HANDLE) TYPE(*UINT) LEN(4) VALUE(0)
DCL VAR(&OLDHANDLE) TYPE(*UINT) LEN(4) VALUE(0)
DCL VAR(&ERR) TYPE(*CHAR) LEN(512)
DCL VAR(&T) TYPE(*CHAR) LEN(26)
DCL VAR(&TLEN) TYPE(*INT) LEN(4) VALUE(26)
DCL VAR(&S) TYPE(*CHAR) LEN(8708)
DCL VAR(&ZERO) TYPE(*CHAR) LEN(1) VALUE(X'00')
MONMSG MSGID(CPF0000 MCH0000) EXEC(GOTO CMDLBL(BAD))
CHGVAR VAR(&O) VALUE(&ZERO)
CHGVAR VAR(%BIN(&O 1 4)) VALUE(1)
CHGVAR VAR(&ERR) VALUE(&ZERO)
CHGVAR VAR(%BIN(&ERR 1 4)) VALUE(512)
CALL PGM(QSYS/QUSPTRUS) PARM('DCNMBUF   QTEMP     ' &BP &ERR)
IF COND(%BIN(&ERR 5 4) *NE 0) THEN(GOTO CMDLBL(BAD))
CALL PGM(QSYS/QUSPTRUS) PARM('DCNMFLAT  QTEMP     ' &FP &ERR)
IF COND(%BIN(&ERR 5 4) *NE 0) THEN(GOTO CMDLBL(BAD))
CALLPRC PRC('QjoRetrieveJournalEntries') PARM(&B &SIZE +
 &J 'RJNE0200' &C &ERR)
IF COND(%BIN(&ERR 5 4) *NE 0) THEN(GOTO CMDLBL(BAD))
CHGVAR VAR(&BYTES) VALUE(%BIN(&B 1 4))
CHGVAR VAR(&AT) VALUE(%BIN(&B 5 4))
IF COND((%BIN(&B 9 4) *NE 1) *OR (&AT *LT 64) *OR +
 (&BYTES *GT &SIZE) *OR (&AT + 236 *GT &BYTES) *OR +
 (%SST(&B 13 1) *NE '0')) THEN(GOTO CMDLBL(BAD))
CHGVAR VAR(&EP) VALUE(&BP)
CHGVAR VAR(%OFFSET(&EP)) VALUE(%OFFSET(&EP) + &AT)
CHGVAR VAR(&HANDLE) VALUE(%BINARY(&E 73 4))
IF COND((%SST(&E 99 1) *NE 'D') *OR +
 ((%SST(&E 100 2) *NE 'CT') *AND +
 (%SST(&E 100 2) *NE 'CG'))) THEN(GOTO CMDLBL(BAD))
CHGVAR VAR(&ESD) VALUE(%BIN(&E 9 4))
IF COND((&ESD *LT 236) *OR +
 (&AT + &ESD + 16 *GT &BYTES)) THEN(GOTO CMDLBL(BAD))
CHGVAR VAR(&DP) VALUE(&EP)
CHGVAR VAR(%OFFSET(&DP)) VALUE(%OFFSET(&DP) + &ESD)
CHGVAR VAR(&DIGITS) VALUE(%SST(&D 1 5))
CHGVAR VAR(&LEN) VALUE(%DEC(&DIGITS 5 0))
CHGVAR VAR(%OFFSET(&DP)) VALUE(%OFFSET(&DP) + 16)
IF COND((&LEN *LT 109) *OR (&LEN *GT 32767) *OR +
 (&AT + &ESD + 16 + &LEN *GT &BYTES)) THEN(GOTO CMDLBL(BAD))
CHGVAR VAR(&FULL) VALUE(&LEN)
IF COND(&HANDLE *NE 0) THEN(DO)
 IF COND(&LEN *LT 160) THEN(GOTO CMDLBL(BAD))
 /* QDBJRNL: external command, apply and remove lengths. */
 IF COND((%BIN(&D 65 4) *LT 0) *OR +
  (%BIN(&D 65 4) *GT 16773120) *OR +
  (%BIN(&D 73 4) *LT 0) *OR +
  (%BIN(&D 73 4) *GT 16773120) *OR +
  (%BIN(&D 81 4) *LT 0) *OR +
  (%BIN(&D 81 4) *GT 16773120)) THEN(GOTO CMDLBL(BAD))
 CHGVAR VAR(&EXTRA) VALUE(%BIN(&D 65 4) + +
  %BIN(&D 73 4) + %BIN(&D 81 4))
 CHGVAR VAR(&FULL) VALUE(&LEN - 16 + &EXTRA)
 IF COND((&EXTRA *LE 0) *OR (&FULL *GT 16773120)) +
 THEN(GOTO CMDLBL(BAD))
 CHGVAR VAR(&COPY) VALUE(&LEN - 16)
 CHGVAR VAR(%SST(&F 1 &COPY)) VALUE(%SST(&D 1 &COPY))
 CHGVAR VAR(&PP) VALUE(&DP)
 CHGVAR VAR(%OFFSET(&PP)) VALUE(%OFFSET(&PP) + &COPY)
 CHGVAR VAR(&SRC) VALUE(&XP)
 CHGVAR VAR(&DST) VALUE(&FP)
 CHGVAR VAR(%OFFSET(&DST)) VALUE(%OFFSET(&DST) + &COPY)
 CALLPRC PRC('memcpy') PARM((&DST *BYVAL) +
  (&SRC *BYVAL) (&EXTRA *BYVAL)) RTNVAL(&RETURN)
ENDDO
ELSE CMD(CHGVAR VAR(%SST(&F 1 &LEN)) VALUE(%SST(&D 1 &LEN)))
CHGVAR VAR(&T) VALUE('D  DCNAMEEXITQTEMP     111')
CHGVAR VAR(%SST(&T 2 2)) VALUE(%SST(&E 100 2))
CHGVAR VAR(&S) VALUE(&ZERO)
CHGVAR VAR(%BIN(&S 1 4)) VALUE(0)
CALL PGM(QSYS/QDBRPLAY) PARM(&T &TLEN 'DBRR0100' &F &FULL &S &ERR)
IF COND(%BIN(&ERR 5 4) *NE 0) THEN(GOTO CMDLBL(BAD))
IF COND((%BIN(&S 1 4) *LT 1) *OR (%BIN(&S 1 4) *GT 16)) +
 THEN(GOTO CMDLBL(BAD))
CHGVAR VAR(%BIN(&O 5 4)) VALUE(&BYTES)
CHGVAR VAR(%BIN(&O 9 4)) VALUE(&AT)
CHGVAR VAR(%BIN(&O 241 4)) VALUE(&LEN)
CHGVAR VAR(%BIN(&O 245 4)) VALUE(&FULL)
CHGVAR VAR(%SST(&O 257 8708)) VALUE(&S)
CHGVAR VAR(%BIN(&O 1 4)) VALUE(0)
GOTO CMDLBL(RELEASE)
BAD: CHGVAR VAR(%BIN(&O 1 4)) VALUE(1)
CHGVAR VAR(%SST(&O 8977 512)) VALUE(&ERR)
RELEASE: IF COND(&HANDLE *NE 0) THEN(DO)
 CHGVAR VAR(&ERR) VALUE(&ZERO)
 CHGVAR VAR(%BIN(&ERR 1 4)) VALUE(512)
 CHGVAR VAR(&OLDHANDLE) VALUE(&HANDLE)
 CHGVAR VAR(&HANDLE) VALUE(0)
 CALLPRC PRC('QjoDeletePointerHandle') PARM(&OLDHANDLE &ERR)
 IF COND(%BIN(&ERR 5 4) *NE 0) THEN(DO)
  CHGVAR VAR(%BIN(&O 1 4)) VALUE(2)
  CHGVAR VAR(%SST(&O 8977 512)) VALUE(&ERR)
 ENDDO
ENDDO
ENDPGM
