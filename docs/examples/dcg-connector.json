{
  "connector.class": "io.debezium.connector.db2as400.As400RpcConnector",
  "name": "ibmi-dcg",
  "dcg.mode": "initialize",
  "dcg.journal": "JOURNALS/APPJRN",
  "dcg.tables": "APPDATA.ORDERS,APPDATA.ITEMS",
  "dcg.controlled.tables": "APPDATA.ORDERS,APPDATA.ITEMS",
  "dcg.journaled.libraries": "",
  "dcg.initialization.window": "/var/lib/kafka-connect/dcg/initialization-window",
  "dcg.retention": "operator-managed",
  "database.schema": "APPDATA",
  "database.dbname": "MYDB",
  "secure": "true",
  "tasks.max": "1",
  "topic.prefix": "ibmi-cdc",
  "schema.history.internal.kafka.bootstrap.servers": "broker:9092",
  "schema.history.internal.kafka.topic": "ibmi-cdc-history",
  "producer.override.bootstrap.servers": "broker:9092",
  "admin.override.bootstrap.servers": "broker:9092",
  "exactly.once.support": "requested",
  "transaction.boundary": "connector",
  "errors.tolerance": "none",
  "event.converting.failure.handling.mode": "fail",
  "event.processing.failure.handling.mode": "fail",
  "skip.messages.without.change": "false",
  "skipped.operations": "none",
  "provide.transaction.metadata": "true",
  "tombstones.on.delete": "true",
  "topic.naming.strategy": "io.debezium.schema.SchemaTopicNamingStrategy",
  "decimal.handling.mode": "precise",
  "binary.handling.mode": "bytes",
  "time.precision.mode": "adaptive_time_microseconds",
  "schema.name.adjustment.mode": "none",
  "field.name.adjustment.mode": "none",
  "trim.non.xml.charsequence.field.mode": "none",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "true",
  "value.converter.schemas.enable": "true",
  "max.batch.size": "128",
  "max.queue.size": "1024",
  "poll.interval.ms": "25",
  "heartbeat.interval.ms": "1000",
  "database.hostname": "${file:/run/secrets/ibmi.properties:database.hostname}",
  "database.user": "${file:/run/secrets/ibmi.properties:database.user}",
  "database.password": "${file:/run/secrets/ibmi.properties:database.password}",
  "dcg.buffer.max.transactions": "64",
  "dcg.buffer.max.entries": "10000",
  "dcg.buffer.max.savepoints": "1024",
  "dcg.buffer.max.bytes": "16777216",
  "dcg.key.mode": "primary-key"
}
