set -euo pipefail
probe_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$probe_root"
if [[ $# != 4 ]]; then
    echo 'Usage: tools/dcg-online-handoff-probe NEW_EVIDENCE_DIRECTORY CAPTURE_DIRECTORY AUDITED_REPLAY_JSON CUT_SEQUENCE (local Docker; no IBM i)' >&2
    exit 2
fi
./mvnw -B -ntp test-compile -DskipTests -DskipITs
./mvnw -B -ntp -pl debezium-connector-ibmi dependency:build-classpath -DincludeScope=test -Dmdep.outputFile=target/connect-probe-classpath.txt
exec python3 -B tools/dcg-online-handoff-probe.py "$@"
