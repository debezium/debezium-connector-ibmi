set -euo pipefail
probe_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$probe_root"
if [[ $# -ne 2 ]]; then
    echo 'Usage: tools/dcg-temporal-probe NEW_EVIDENCE_DIRECTORY DCNCdddd (fresh IBM i fixture writes; local Docker)' >&2
    exit 2
fi
probe_python=${PYTHON:-python3}
./mvnw -B -ntp package -Passembly -DskipTests -DskipITs
./mvnw -B -ntp -pl debezium-connector-ibmi dependency:build-classpath -DincludeScope=test -Dmdep.outputFile=target/connect-probe-classpath.txt
exec "$probe_python" -B tools/dcg-temporal-probe.py "$@"
