set -euo pipefail
probe_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$probe_root"
if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo 'Usage: tools/dcg-first-start-probe NEW_EVIDENCE_DIRECTORY [ack|crash|qualification|stop|fencing] (local Docker only; no IBM i)' >&2
    exit 2
fi
./mvnw -B -ntp test-compile -DskipTests -DskipITs
./mvnw -B -ntp -pl debezium-connector-ibmi dependency:build-classpath -DincludeScope=test -Dmdep.outputFile=target/connect-probe-classpath.txt
exec "${PYTHON:-python3}" -B tools/dcg-first-start-probe.py "$@"
